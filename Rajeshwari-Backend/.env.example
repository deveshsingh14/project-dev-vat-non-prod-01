# Environment Variables Setup

# Database Connection String (Neon DB recommended)
# For local development, use a Neon *dev branch* or a local Postgres — NOT
# the production database. Tests that write data (npm run test:db) refuse
# to run unless this points at localhost.
DATABASE_URL="postgresql://<neon_user>:<neon_password>@<neon_host>/<dbname>?sslmode=require"

# JWT Secret for Authentication
JWT_SECRET="your_secret_key"

# Port for Backend Server
PORT=5000

# Admin Setup Credentials (used by resetAdminPassword.js)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourSecurePassword!"

# Role-Based Access Control Features
# Set to "true" to allow ADMIN to promote regular customers to OWNER
ENABLE_OWNER_PROMOTION="true"

# Cloudinary (product image storage — from your Cloudinary dashboard)
# Required so uploaded product images survive a backend restart/redeploy.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Sentry (error monitoring — from your Sentry project's Client Keys/DSN)
# Optional: without it the app runs fine, just with no error reporting.
SENTRY_DSN="your_sentry_dsn"

# Web Push (order notifications) — optional; notifications are disabled if unset.
# Generate once with:  npx web-push generate-vapid-keys
# The private key is a secret: set it only here (locally) and in the Render dashboard.
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:owner@yourdomain.com"
