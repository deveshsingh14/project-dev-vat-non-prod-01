# Environment Variables Setup

# Database Connection String (Neon DB recommended)
DATABASE_URL="postgresql://<neon_user>:<neon_password>@<neon_host>/<dbname>?sslmode=require"

# JWT Secret for Authentication
JWT_SECRET="your_secret_key"

# Port for Backend Server
PORT=5000

# Admin Setup Credentials (used by resetAdminPassword.js)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourSecurePassword!"

# Role-Based Access Control Features
# Set to "true" to allow ADMIN to promote regular customers to OWNER
ENABLE_OWNER_PROMOTION="true"
